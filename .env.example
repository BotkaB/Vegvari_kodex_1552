# API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
#szerveren futó port pl.: 3000, 8080
PORT=
#development or production
NODE_ENV=
# Session & Security
# KÖTELEZŐ – minimum 32 karakter
SESSION_SECRET=
# KÖTELEZŐ
AUTH_USERNAME=
# KÖTELEZŐ
AUTH_PASSWORD=
# OPCIONÁLIS – ha beállítod, bcrypt hash-elés aktiválódik (biztonságosabb)
# AUTH_PASSWORD_HASH=

# http://localhost:3000
CLIENT_URL=

# --- CORS / Frontend URL-ek ---
# Jelenlegi monolit (localhost:3000) esetén NEM KÖTELEZŐ (fallback: http://localhost:3000)
# Ha külön frontend domain (Vercel, Netlify, stb.) pl:https://vegvari-kodex.vercel.app:
# FRONTEND_PROD_URL=

# Fejlesztés Vite-tal (npx vite -> port 5173) esetén:
# CLIENT_URL=http://localhost:5173

